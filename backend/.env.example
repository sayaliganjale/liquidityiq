# MongoDB Connection URI (e.g., MongoDB Atlas in production)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=liquidity_db

# Security & Tokens
JWT_SECRET=replace_with_a_secure_random_string_in_production
ENV=production

# Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS (comma-separated if multiple domains)
FRONTEND_URL=https://your-frontend-app.vercel.app,http://localhost:3000

# Optional initial admin credentials
ADMIN_EMAIL=admin@liquidityiq.com
ADMIN_PASSWORD=admin123
